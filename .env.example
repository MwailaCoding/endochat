# EndoChat Backend Environment Variables
# Copy this file to .env and fill in your values

# =============================================================================
# DATABASE
# =============================================================================

# PostgreSQL connection URL
# Format: postgresql://user:password@host:port/database
DATABASE_URL=postgresql://postgres:password@localhost:5432/endochat

# Connection pool settings
DB_POOL_MIN_SIZE=5
DB_POOL_MAX_SIZE=20

# =============================================================================
# REDIS CACHE (Optional)
# =============================================================================

# Redis connection URL (leave empty to use in-memory cache)
REDIS_URL=redis://localhost:6379

# Cache TTL in seconds (default: 24 hours)
CACHE_TTL_SECONDS=86400

# Enable/disable caching
CACHE_ENABLED=true

# =============================================================================
# OPENAI (Optional - for LLM answer generation)
# =============================================================================

# OpenAI API Key
# Get from: https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Model to use (gpt-3.5-turbo or gpt-4)
OPENAI_MODEL=gpt-3.5-turbo

# Enable/disable LLM features
OPENAI_ENABLED=true

# =============================================================================
# HEALTH API KEYS
# =============================================================================

# PubMed/NCBI E-utilities
# Register at: https://www.ncbi.nlm.nih.gov/account/
# Higher rate limits with API key (10/sec vs 3/sec)
PUBMED_API_KEY=
PUBMED_EMAIL=developer@endochat.org

# OpenFDA API Key (optional, increases rate limits)
# Register at: https://open.fda.gov/apis/authentication/
OPENFDA_API_KEY=

# DrugBank API Key (Academic license required)
# Apply at: https://go.drugbank.com/
DRUGBANK_API_KEY=

# =============================================================================
# WEB SEARCH - TAVILY (Optional - for live internet search in chat)
# =============================================================================

# Enable web search in chat (combines medical APIs + web results)
WEB_SEARCH_ENABLED=true
WEB_SEARCH_API_KEY=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
WEB_SEARCH_MAX_RESULTS=5
                                
# =============================================================================
# API SETTINGS
# =============================================================================

# Request timeout in seconds
API_TIMEOUT=10

# Maximum retry attempts for failed requests
API_MAX_RETRIES=3

# =============================================================================
# RATE LIMITING
# =============================================================================

# Maximum requests per period per client
RATE_LIMIT_REQUESTS=100

# Rate limit period in seconds
RATE_LIMIT_PERIOD=60

# =============================================================================
# CORS
# =============================================================================

# Allowed origins (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# =============================================================================
# APPLICATION
# =============================================================================

# Enable debug mode (additional logging, auto-reload)
DEBUG=false

# =============================================================================
# CLOUDINARY (Image Storage)
# =============================================================================

# Get credentials from: https://cloudinary.com/console
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# =============================================================================
# HTML-TO-IMAGE API
# =============================================================================

# Get from: https://htmlcsstoimage.com/
HCTI_API_USER_ID=
HCTI_API_KEY=

# =============================================================================
# FEATURE FLAGS
# =============================================================================

# Enable/disable enhanced features
ENABLE_STORIES=true
ENABLE_GROUPS=true
ENABLE_CANDLES=true
ENABLE_INSIGHTS=true
ENABLE_SHARING=true
